# --- Application ---
NEXT_PUBLIC_APP_NAME="Cvia"
APP_URL="http://localhost:3000"
# Secret de signature des sessions (openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# --- Base de données ---
# Développement : SQLite. Production : PostgreSQL (changer provider dans prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# --- Compte administrateur créé par le seed ---
ADMIN_EMAIL="admin@cvia.local"
ADMIN_PASSWORD="Admin#2026"

# --- FedaPay (laisser vide = mode démo avec paiement simulé) ---
FEDAPAY_ENV="sandbox"
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""

# --- Stockage des fichiers (photos, PDF) ---
STORAGE_DIR="./data/uploads"

# --- PDF ---
PDF_TIMEOUT_MS="20000"
