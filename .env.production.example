# Example production environment variables for cvia
# Copy this file to .env.production (or set values in Vercel) and fill the values.

# App
NEXT_PUBLIC_APP_NAME="Cvia"
APP_URL="https://example.com"

# Auth / sessions
AUTH_SECRET="change-me-to-a-long-random-string"

# Database
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Admin bootstrap (optional)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="A_Strong_Password123!"

# FedaPay (leave empty to use demo/simulated payments)
FEDAPAY_SECRET_KEY=""
FEDAPAY_ENV="sandbox"
FEDAPAY_WEBHOOK_SECRET=""

# Storage (use S3/GCS in prod; keep blank if using provider-managed storage)
STORAGE_DIR="./data/uploads"

# PDF generator timeout (ms)
PDF_TIMEOUT_MS="20000"

# Optional: any other env vars you use locally
# MAIL_* or SMTP_ variables if you configure outgoing email
# NEXT_PUBLIC_... variables will be exposed to the browser
